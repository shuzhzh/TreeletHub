    "watch.connect.intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the 6-digit code from TreeletHub on your Mac. Your iPhone must be nearby — it owns the Mac connection and stays in sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Mac 上 TreeletHub 显示的 6 位配对码。需与 iPhone 联动：由手机连接 Mac，两边状态会同步。"
          }
        }
      }
    },
