    "ios.settings.background_footer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One custom photo is kept at a time—use “+” to pick or replace it. Tap the thumbnail to use it as the background; press and hold to delete. Dark presets (Deep Azure, Royal Plum, Charcoal Silk) follow dark appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册仅保留一张：用「+」选取或覆盖；点缩略图启用相册背景，长按删除。深海、御紫、炭灰等深色预设会跟随深色界面。"
          }
        }
      }
    },
    "ios.settings.delete_photo_bg": {
