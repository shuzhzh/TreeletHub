    "English" : {

    },
    "guide.body.ai_pad" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put ChatGPT, Codex, or Cursor into the hub grid, then tap it on iPhone: instead of just launching the app, your phone becomes a dedicated controller for that agent, and the whole vibe-coding loop moves into your hand. Kick off a run, approve or redirect what the agent proposes, tune how hard it thinks, and jump between chat, edits, and the terminal — the model keeps working while you stay in the flow, phone in hand and away from the keyboard.\nChatGPT, Codex, and Cursor each get a layout tuned to how you actually drive them, and every control is remappable to fit your workflow.\nThe Mac needs Accessibility and Automation permission for TreeletHub — without it the controller shows a warning and the keys do nothing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 ChatGPT、Codex 或 Cursor 放进九宫格，在 iPhone 上点按它：手机不再只是启动应用，而是变成这个 agent 的专属控制器，整个 vibe coding 循环都握在手里。发起一次运行、批准或纠偏 agent 的提议、调节它思考的深浅、在对话 / 改动 / 终端之间切换——模型持续推进，你握着手机、离开键盘也能保持心流。\nChatGPT、Codex、Cursor 各有贴合你实际操作方式的布局，且每个控件都能自定义映射。\nMac 需要为 TreeletHub 开启「辅助功能」与「自动化」权限，否则控制器会提示未授权、按键无效。"
          }
        }
      }
    },
    "guide.body.connect_ios" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) On the Mac, open TreeletHub and read the six-digit pairing code.\n2) On iPhone, open Connect to Mac, type the code, then tap Connect.\n3) The first time, allow Local Network access when iOS prompts you—without it, the phone cannot discover the Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1）在 Mac 上打开 TreeletHub，记下界面上的 6 位配对码。\n2）在 iPhone 的「连接 Mac」中输入配对码并点击连接。\n3）首次连接请在系统提示中允许「本地网络」，否则无法发现 Mac。"
          }
        }
      }
    },
    "guide.body.gestures_ios" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Apps grid while paired: swipe down with two fingers to hide every open Mac app—including TreeletHub—and show the desktop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配对时在 Apps 九宫格上：双指下滑会隐藏 Mac 上全部已打开应用（含 TreeletHub 自身）以显示桌面。"
          }
        }
      }
    },
    "guide.body.push_to_talk" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Hold the PTT key on the control pad and speak—the words you say appear on the phone in real time.\n2) Recognition runs on the iPhone itself. No audio leaves the phone; only the finished text travels across your Wi‑Fi to the Mac.\n3) Let go and the text lands in the ChatGPT / Codex / Cursor composer on the Mac. Read it over, then tap Send.\nDouble-tap PTT within 350 ms for hands-free recording, and tap once more to stop. The first time you use it, allow Microphone and Speech Recognition on the iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1）在控制键盘上按住「PTT」键说话，手机上会实时显示识别出的文字。\n2）识别全程在 iPhone 本机完成，音频不会离开手机，只有最终文字经 Wi‑Fi 发送到 Mac。\n3）松手后文字会自动填入 Mac 上 ChatGPT / Codex / Cursor 的输入框，确认无误后点「Send」发送。\n350 毫秒内双击 PTT 可进入免提录音，再点一次结束。首次使用请允许 iPhone 的「麦克风」与「语音识别」权限。"
          }
        }
      }
    },
    "guide.body.scenarios" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep TreeletHub running on the desk Mac. From the couch or another room, use your iPhone as a remote launcher for apps you already placed in the hub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上常驻 TreeletHub；你在客厅或别的房间，用 iPhone 快速唤起已放进九宫格的 Mac 应用。"
          }
        }
      }
    },
    "guide.body.setup_ios" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Apps tab for the live grid. In Settings, rename how your iPhone appears on the Mac, change the backdrop, or swap your one saved photo background."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「Apps」使用实时九宫格；在「设置」里可修改在 Mac 上显示的设备名、更换界面背景，或替换仅保留一张的相册背景。"
          }
        }
      }
    },
    "guide.body.setup_mac" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Tap any cell and choose a Mac app (.app) to assign.\n2) Drag tiles to swap or move apps between cells.\n3) Extra tabs (Apps1, …) add more pages; some tabs require an active subscription.\n4) If you regenerate the pairing code on the Mac, each iPhone must reconnect with the new code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1）点按格子并选择要绑定的应用程序（.app）。\n2）拖拽已配置的应用在格子间交换或移动。\n3）多页 Tab（Apps、Apps1…）可扩展更多页面；部分页面可能需要订阅。\n4）在 Mac 上重新生成配对码后，已配对的 iPhone 需用新码重新连接。"
          }
        }
      }
    },
    "guide.body.what" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub lets you arrange favorite Mac apps in a grid on the Mac, then open TreeletHub on your iPhone—on the same Wi‑Fi—to launch those apps remotely. Reorder slots with drag and drop on either side."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub 让你在 Mac 上把常用应用摆成九宫格，再在同一个 Wi‑Fi 下的 iPhone 上远程点按启动；两端都支持拖拽调整格子顺序。"
          }
        }
      }
    },
