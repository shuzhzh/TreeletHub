    "ios.settings.device_footer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This label is what paired Macs show in their device list. Disconnect and connect again if you change it."
          }
        },
        "zh-Hans": {
