        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap ChatGPT, Codex, or Cursor in the Apps grid to open its control keyboard and drive the whole vibe-coding loop from your hand: start a run, approve or redirect the agent, and tune how hard it thinks — phone in hand, away from the keyboard."
          }
