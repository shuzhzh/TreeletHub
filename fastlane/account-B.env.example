# 复制为 fastlane/.env.accountB
# 使用：fastlane ios beta --env accountB

FASTLANE_TEAM_ID=YYYYYYYYYY
FASTLANE_APP_IDENTIFIER=com.other.iosapp
FASTLANE_MAC_APP_IDENTIFIER=com.other.macapp
FASTLANE_SCHEME=TreeletHub
FASTLANE_MAC_SCHEME=TreeletHub_Mac

APP_STORE_CONNECT_KEY_ID=YYYYYYYYYY
APP_STORE_CONNECT_ISSUER_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
APP_STORE_CONNECT_KEY_PATH=fastlane/keys/accountB/AuthKey_YYYYYYYYYY.p8
