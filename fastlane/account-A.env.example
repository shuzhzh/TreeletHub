# 复制为 fastlane/.env.accountA（文件名决定 --env 的名称）
# 使用：fastlane ios beta --env accountA
#
# 每个 Apple Developer 账号在 App Store Connect 各有一套 API 密钥（Key ID / Issuer / .p8）

FASTLANE_TEAM_ID=XXXXXXXXXX
FASTLANE_APP_IDENTIFIER=com.treelet.TreeletHub
FASTLANE_MAC_APP_IDENTIFIER=com.treelet.TreeletHub-Mac
FASTLANE_SCHEME=TreeletHub
FASTLANE_MAC_SCHEME=TreeletHub_Mac

APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_PATH=fastlane/keys/accountA/AuthKey_XXXXXXXXXX.p8

# 可选：若该 Apple ID 下有多个组织，需指定 App Store Connect 里的团队
# FASTLANE_ITC_TEAM_ID=123456789

# 可选：不用 API Key 时
# FASTLANE_USER=dev@example.com
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
