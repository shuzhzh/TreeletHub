    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub uses Apple Events to read now-playing metadata from the Music app for Dynamic Island."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub 需要通过 Apple Events 读取「音乐」App 的播放进度与曲目信息，以便在灵动岛显示播放状态。"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
