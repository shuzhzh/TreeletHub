    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub advertises on your local network so iPhones on the same Wi‑Fi can discover and pair with this Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub 需要通过本地网络广播服务，供同一 Wi‑Fi 下的 iPhone 发现并连接。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub uses your approximate location to show local weather and forecasts through WeatherKit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub 需要大致位置以通过 WeatherKit 显示当地天气与预报。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub needs Screen Recording access to invoke the system screenshot tool for screenshot shortcuts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TreeletHub 需要屏幕录制权限以调用系统截图工具（screencapture）完成截图快捷操作。"
          }
        }
      }
    }
  },
  "version" : "1.0"
