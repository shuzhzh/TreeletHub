    "mac.subscription.benefit_keyboardhud_p1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard Launcher maps your Mac apps onto an on-screen keyboard. Press Control to summon the overlay, then tap a key—or press Control + key from anywhere—to launch or hide the app instantly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘启动器把 Mac 应用映射到屏幕键盘上：按下 Control 唤出浮层，直接按键或 Control + 按键，即可在任意位置瞬间唤起或隐藏对应应用。"
          }
        }
      }
    },
    "mac.subscription.benefit_keyboardhud_p2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps are auto-assigned by first letter on first use. Drag to swap keys, click to add or replace, and build a muscle-memory launcher that feels faster than the Dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次开启会按应用名称首字母自动填充键位；支持拖拽交换、点击添加或替换，打造比程序坞更顺手的肌肉记忆启动方式。"
          }
        }
      }
    },
    "mac.subscription.benefit_keyboardhud_p3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect for power users who live on the keyboard: fewer mouse trips, fewer context switches, and one Control press away from any app you care about."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
