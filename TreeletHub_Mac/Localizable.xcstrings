        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes media shortcuts, clock, location-aware weather (Apple Weather / WeatherKit), clipboard history, staging, AirDrop hand-off, and the same hub grid you see on iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
