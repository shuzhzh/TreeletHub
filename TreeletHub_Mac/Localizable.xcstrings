    "intro.step1.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep TreeletHub open on your Mac. Apps and shortcuts live here; the phone is a remote control, not a standalone launcher."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Mac 上保持 TreeletHub 运行。应用与快捷方式都配置在这里；手机是遥控器，不能单独当启动器。"
          }
        }
      }
    },
    "intro.step1.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is the hub"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 Mac 电脑为中心"
          }
        }
      }
    },
    "intro.step2.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the code shown on Mac in the iPhone app (same Wi‑Fi). Allow Local Network when iOS asks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 端输入 Mac 上显示的配对码（需同一 Wi‑Fi）；系统提示时请允许「本地网络」。"
          }
        }
      }
    },
